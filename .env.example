# ============================================================
#  JARVIS configuration — edit and restart
# ============================================================

# --- identity -----------------------------------------------
USER_NAME=Sir
USER_TITLE=Sir
ASSISTANT_NAME=JARVIS
WAKE_WORD=hey jarvis

# --- brain --------------------------------------------------
# auto = Ollama first, then any cloud provider with a real key
BRAIN_PROVIDER=auto
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_FAST_MODEL=qwen3:0.6b
OLLAMA_TIMEOUT=120
AI_TEMPERATURE=0.6
AI_MAX_TOKENS=600

# Optional cloud fallbacks (leave blank to stay fully local)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# --- voice --------------------------------------------------
STT_MODEL=base.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
WAKE_ENGINE=openwakeword
WAKE_THRESHOLD=0.55
# MIC_DEVICE=13

TTS_ENGINE=edge
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=+8%

VOICE_LOCK_ENABLED=true
VOICE_MATCH_THRESHOLD=0.78
VOICE_ENROLL_SECONDS=12

# --- safety -------------------------------------------------
CONFIRM_DESTRUCTIVE=true
CONFIRM_TTL_SECONDS=25
ALLOW_POWER_ACTIONS=true
ALLOW_SHELL=false
ALLOW_FILE_DELETE=true
PRIVACY_ON_START=false

# --- interface modes ---------------------------------------
DEFAULT_MODE=normal

# --- home assistant (optional) ------------------------------
# Long-lived token from your Home Assistant profile page.
HASS_URL=
HASS_TOKEN=

# --- location & news ---------------------------------------
DEFAULT_CITY=Vijayawada
WEATHER_API_KEY=
NEWS_API_KEY=
# NEWS_FEEDS=https://news.google.com/rss?hl=en-IN&gl=IN&ceid=IN:en,https://feeds.bbci.co.uk/news/world/rss.xml

# --- email accounts -----------------------------------------
# One block per account; the label is spoken ("read my college email").
# Use app passwords. Hosts are auto-detected; override if your college differs.
EMAIL_DEFAULT_ACCOUNT=personal

MAIL_PERSONAL_ADDRESS=
MAIL_PERSONAL_PASSWORD=
# MAIL_PERSONAL_SMTP_HOST=
# MAIL_PERSONAL_SMTP_PORT=587
# MAIL_PERSONAL_SMTP_SSL=false
# MAIL_PERSONAL_IMAP_HOST=
# MAIL_PERSONAL_IMAP_PORT=993
# MAIL_PERSONAL_DISPLAY_NAME=Personal

MAIL_COLLEGE_ADDRESS=
MAIL_COLLEGE_PASSWORD=
# MAIL_COLLEGE_SMTP_HOST=
# MAIL_COLLEGE_SMTP_PORT=587
# MAIL_COLLEGE_SMTP_SSL=false
# MAIL_COLLEGE_IMAP_HOST=
# MAIL_COLLEGE_IMAP_PORT=993
# MAIL_COLLEGE_DISPLAY_NAME=College

# Legacy single account (still supported)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
IMAP_HOST=
IMAP_PORT=993

# --- browser ------------------------------------------------
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
BROWSER_HEADLESS=false
BROWSER_LOGIN_TIMEOUT=180

# --- server -------------------------------------------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DEBUG_MODE=false
JARVIS_VERSION=3.0.0
